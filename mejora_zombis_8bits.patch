+      '.O...OOEEKKKKOEEKkO.....',
+      'OqO..OOOOKKKKOOOKkO.....',
+      'qOqO..OqKKKkkKKKkO....O.',
+      'qqkO..OkTOTOTOTOkO...OqO',
