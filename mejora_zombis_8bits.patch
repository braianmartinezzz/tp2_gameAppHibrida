+      'OqKkO..OOTOROTOOO...Oqqk',
+      'OqKkO..OkBkkkkBkO...OkKk',
+      'OqKkOOOOOBOOOOOOOOOO.Oqk',
+      'OqKKzzzzqqqqqqqqzzzsOOqk',
+      'OqKKKKSSKKKKKKKKSSSSqqKk',
+      'OqKKKKSSKKKKKKKKSSSSKKKk',
+      'OqKKKKSSKKKKKKKKSSSSKKKk',
+      'OqKKKKKKKKKKKKbBKKSKkKKk',
+      'OqBKKKKKKKKKKKbKKKskOqBk',
+      'OqKKKKKKKKKKKKKbBKKkOqKk',
+      'OqKKKKkkkkkkKKKbKKKkOkKk',
+      'OkkkKKKKKKKkKKKKbBKkOOkk',
+      '.OOOqKKKKKkOqKKbKKKkO.OO',
+      '...OqKKkkkkkkKKbBKKkO...',
+      '...OqKKKKKKKKKKKKKKkO...',
+      '...OqKKKKKKKKKKKKKKkO...',
+      '...OkKkkkkkkKKKKKKKkO...',
+      '....OqKKKKKKKKKKKKkO....',
+      '....OqKKKKKKKKKKKKkO....',
+      '...OPPKKKKKKKKKKKKPpO...',
+      '...OPPPKKKKKKKKKKPPpO...',
+      '...OPPPPPKKkkKKBBPPpO...',
+      '...OPpPpPppOOPBBBPPpO...',
+      '...OpOpOpOpOOPPPPPPpO...',
+      '....OqKqKkO.OPPPPPPpO...',
+      '....OqKKKkO.OPpPpPppO...',
+      '....OqKKKkO.OpOpOpOpO...',
+      '...OqKkKkKkO.OqKqKkO....',
+      '...OkkkkkkkO.OqKKKkO....',
+      '....OOOOOOO..OqKKKkO....',
+      '............OqKkKkKkO...',
+      '............OkkkkkkkO...',
+    ],
+    [
+      '...........OO...........',
