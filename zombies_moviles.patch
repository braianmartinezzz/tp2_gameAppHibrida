+/// Píxeles con alfa > 0 en un buffer RGBA.
+int _opaquePixels(Uint8List rgba) {
+  var n = 0;
+  for (var i = 3; i < rgba.length; i += 4) {
+    if (rgba[i] > 0) n++;
+  }
+  return n;
+}
